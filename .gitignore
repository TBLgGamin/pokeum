# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Per-user agent state: the shared agent setup lives only in .agents/, so any local
# .claude/ (Claude Code writes settings.local.json there) is never committed.
.claude/
CLAUDE.local.md

# Local environment / secrets
.env

# Personal deployment notes/config (not part of the public repo)
/deploy/

# Reference data: downloaded TCGdex images, SQLite catalogue, embedding index,
# and exported models. Large and fully regenerable via `sync` + `index build`.
/data/
*.onnx

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# mypy daemon state (per-clone, never committed)
.dmypy.json
dmypy.json

# Agent scratch space: temp scripts, probes, one-off outputs (never the repo root)
.agents/scratch/
