# Normalise line endings: LF in the repository for all text files, regardless
# of the contributor's OS. Ends the CRLF-warning noise on Windows.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cfg text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Git hooks run under sh, also on Windows: CRLF would break the shebang line.
.agents/git-hooks/* text eol=lf
